# Serverconfiguratie voor de statische build van madebypatrick.nl.
# Dit bestand staat in public/ en komt dus bij elke build mee in dist/,
# zodat de serverinstellingen samen met de site versiebeheerd worden.

# SPA-fallback. Bestaande bestanden en mappen gewoon uitserveren, al het
# overige naar index.html, zodat react-router een directe link naar /projects
# afhandelt in plaats van dat Apache een 404 geeft.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Assets, og-image, sitemap en dergelijke met rust laten.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Al het overige naar het startpunt van de app (200, geen redirect).
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite zet een contenthash van acht tekens in de bestandsnaam, bijvoorbeeld
  # index-BgwBZwm-.css. Zulke bestanden kunnen nooit veranderen zonder dat ook
  # hun naam verandert, dus die mogen een jaar in de cache blijven staan.
  # Bestanden uit public/ (og-image.png, ps.svg) hebben geen hash en vallen
  # hier bewust buiten, zodat je die gewoon kunt vervangen.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|svg|png|jpe?g|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html juist nooit cachen, anders blijven bezoekers na een deploy op
  # de oude bundle hangen terwijl de assets al vervangen zijn.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
